{
  "name": "11labs-realtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:call": "node --env-file=.env.local scripts/generate-call-audio.ts",
    "audio:emotions": "node --env-file=.env.local scripts/generate-emotion-audio.ts",
    "build": "tsc -b && vite build",
    "deadcode": "fallow dead-code",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "react-doctor": "react-doctor --no-telemetry --no-supply-chain -y",
    "translate:options": "node --env-file=.env.local scripts/generate-translate-options.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-hotkeys": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6",
    "fallow": "^3.33.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-doctor": "^0.9.18",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.2",
    "vite": "^8",
    "wrangler": "^4.151.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm deadcode && pnpm react-doctor --staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,md,html,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.28.1"
}
