    "translate:options": "node --env-file=.env.local scripts/generate-translate-options.ts",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-hotkeys": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8"
  }
